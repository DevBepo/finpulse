{
  "name": "finpulse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @finpulse/contracts build && pnpm -r typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "pnpm --filter @finpulse/contracts build && vitest run",
    "test:unit": "pnpm --filter @finpulse/contracts build && vitest run --project unit --project web",
    "test:integration": "pnpm --filter @finpulse/contracts build && vitest run --project integration",
    "dev": "pnpm --filter @finpulse/contracts build && pnpm --parallel --filter @finpulse/api --filter @finpulse/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^24.19.4",
    "jsdom": "^29.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
