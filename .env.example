# Local PostgreSQL credentials. Keep DATABASE_URL and TEST_DATABASE_URL in sync.
POSTGRES_USER=finpulse
POSTGRES_PASSWORD=finpulse_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finpulse:finpulse_local@127.0.0.1:5432/finpulse_dev
TEST_DATABASE_URL=postgresql://finpulse:finpulse_local@127.0.0.1:5432/finpulse_test

# Optional backend settings. These values are the defaults.
APP_TIMEZONE=America/Sao_Paulo
API_PORT=3000
